executable:${TEXTTEST_ROOT}/testdata.py

config_module:default

default_interface:console

create_catalogues:true

# testdata.py rewrites writefile but resets its modified time afterwards (mimicking
# e.g. the win32 CopyFile API). detect_file_changes_by_checksum makes both the catalogue
# and the collation below notice the change by content checksum (SHA256); a plain
# modification-time comparison would miss it entirely.
detect_file_changes_by_checksum:true

home_operating_system:posix

copy_test_path:writefile

[collate_file]
editedfile:writefile
